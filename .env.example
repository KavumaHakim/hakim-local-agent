# Copy to .env and fill in what you need. Nothing here is required: with this
# file absent or empty, the agent runs entirely on local models and never
# touches the network.
#
#     cp .env.example .env          (Linux/macOS)
#     copy .env.example .env        (Windows)
#
# .env is git-ignored. This file is not, so it carries variable NAMES and
# never values - not even plausible-looking placeholder ones, which are the
# thing most likely to be committed by accident and then trusted.
#
# Real environment variables win over anything set here, so exporting a key in
# the shell overrides the file rather than being silently ignored.


# --- Hosted models -------------------------------------------------------
#
# Optional. Each is named in models.json under "api_key_env"; adding a key
# here is what makes that model selectable rather than greyed out. A turn sent
# to one leaves this machine, and the UI asks before it does.

# GEMINI_API_KEY=
# CEREBRAS_API_KEY=


# --- Where the agent may look --------------------------------------------
#
# The one directory the file tools can reach. Defaults to the project itself.
# It can also be changed from the UI, but only for that session - this is the
# setting that survives a restart.

# AGENT_WORKSPACE=/home/you/projects/notes


# --- Tools that are off by default ---------------------------------------
#
# Every one of these is off because it can do something you should agree to
# first. They can also be switched on from the sidebar, in memory only; set
# them here to have them on at every start. Read the security notes in the
# README before enabling the last three.

# AGENT_ENABLE_FILE_WRITES=1     create files in the workspace (no delete/rename)
# AGENT_ENABLE_GIT_TOOL=1        read git state; AGENT_GIT_ALLOW_WRITES=1 to commit
# AGENT_ENABLE_MEMORY=1          durable facts across conversations
# AGENT_ENABLE_RAG=1             semantic search over your own documents
# OCR_ENABLED=1                  read text out of images

# AGENT_ENABLE_HTTP_TOOL=1       loopback only unless AGENT_HTTP_HOSTS widens it
# AGENT_ENABLE_SHELL_TOOL=1      allowlisted read-only commands - not a sandbox
# AGENT_ENABLE_PYTHON_TOOL=1     restricted Python - not a sandbox


# --- OCR -----------------------------------------------------------------
#
# "tesseract" is a ~50 MB binary, under a second a page, text only.
# "model" is GLM-OCR: ~1.4 GB and ~30 s a page, but it reads tables, columns
# and handwriting. Neither is strictly better, which is why it is a switch.

# OCR_BACKEND=tesseract
# TESSERACT_CMD=/usr/bin/tesseract


# --- Tuning --------------------------------------------------------------
#
# Local generation is slow, so the request timeout is generous by default.
# Raise it further if you see QwenTimeoutError on a large model.

# AGENT_REQUEST_TIMEOUT=1200
# AGENT_MAX_ITERATIONS=8
# AGENT_DB_PATH=data/chat_history.db
