# Model weights: gigabytes of binaries that must never enter a repo.
weights/

# Speech models, for the same reason. Separate from weights/ because these are
# ggml-*.bin whisper models, not GGUFs, and model discovery ignores them.
whisper/

# llama.cpp, fetched by the setup script. Someone else's binaries, and
# tens of megabytes of them - they belong in a release, not in here.
vendor/

# Generated state.
data/
*.db

# Python and tooling.
.venv/
__pycache__/
*.pyc

# Stray downloads.
*.apk

# Secrets. The cloud providers need API keys, and this is a git repository now,
# so the keys live in a file that can never be committed. `.env.example` IS
# committed, and carries variable names with no values - not even
# plausible-looking placeholders, which are the thing most likely to be
# committed by accident and then trusted.
.env
.env.*
!.env.example
*.key
secrets.json

# Images uploaded through the web UI. They land inside the workspace because
# that is the only place the OCR tool can read from, which puts them here when
# the workspace is the project itself.
uploads/
